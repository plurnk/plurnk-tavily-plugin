{
    "compilerOptions": {
        "target": "ES2024",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "customConditions": [
            "plurnk-dev"
        ],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "allowImportingTsExtensions": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "src"
    ]
}
