# ── Defaults (floor-set; override to change) ────────────────────────────────
# Tavily Extract depth ("basic" or "advanced").
PLURNK_SCHEMES_HTTP_TAVILY_DEPTH=basic
# Tavily Extract request timeout in ms.
PLURNK_SCHEMES_HTTP_TAVILY_TIMEOUT_MS=30000

# ── Optional modes (absence IS the mode — never floor-set) ──────────────────
# The Tavily API key (https://tavily.com): web search and page extraction. When
# omitted/unset, this materializer reports itself ineligible and the http scheme's
# local projection produces the page's #readable.
# TAVILY_API_KEY=
